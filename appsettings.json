{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=digitalpostwallet;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Authority": "http://localhost:5002",
    "MetadataAddress": "http://localhost:5002/.well-known/openid-configuration",
    "Issuer": "AuthenticationService",
    "Audience": "AuthServiceClient",
    "RequireHttpsMetadata": false,
    "AutomaticRefreshIntervalHours": 12,
    "RefreshIntervalMinutes": 5
  },
  "Wallet": {
    "MinimumTransactionGapSeconds": 5
  },
  "TokenRevocation": {
    "BaseUrl": "http://localhost:5005"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
